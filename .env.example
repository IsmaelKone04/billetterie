# Copier ce fichier en `.env` puis renseigner les valeurs.
# `.env` est ignoré par git : aucun secret ne doit être commité.

# --- Postgres ---
# POSTGRES_HOST=postgres quand on lance via docker-compose (nom du service).
# En local hors Docker (ex. manage.py runserver direct) : POSTGRES_HOST=localhost.
# Port hôte décalé à 5433 (le 5432 par défaut est déjà pris par le projet
# monbail qui tourne en parallèle sur cette machine) — POSTGRES_PORT contrôle
# à la fois le port publié par docker-compose et celui utilisé par Django en
# local.
POSTGRES_DB=billetterie
POSTGRES_USER=billetterie
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Django (admin-django) ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- FastAPI (api-fastapi) ---
# Même logique que POSTGRES_HOST : REDIS_HOST=redis (nom du service) via
# docker-compose, REDIS_HOST=localhost hors Docker.
REDIS_HOST=localhost
# Port hôte décalé à 6380 (6379 déjà pris par monbail sur cette machine).
REDIS_PORT=6380
# Même logique que DJANGO_DEBUG : autorise des secrets de dev par défaut
# pour JWT_SECRET/SCAN_API_KEY quand ils sont vides. À laisser à false en
# production (secret manquant = endpoint concerné refuse, jamais un secret
# devinable).
API_DEBUG=true
# Signe/vérifie le token QR des billets.
JWT_SECRET=
# Clé exigée dans l'en-tête X-Scan-Key de POST /scan (donnée manuellement
# au staff qui scanne à l'entrée).
SCAN_API_KEY=
# Signe le JWT de session organisateur (inscription/connexion/dashboard) —
# secret distinct de JWT_SECRET, à ne jamais partager entre les deux usages.
ORGANIZER_JWT_SECRET=
# Origines autorisées (CORS) à appeler cette API depuis un navigateur — le
# frontend Next.js en dev par défaut. Pas un secret, juste une liste de
# confiance ; séparer par des virgules pour en ajouter d'autres en prod.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Paiement Mobile Money (CinetPay) ---
# PAYMENT_PROVIDER=simulator en développement tant qu'il n'y a pas
# d'identifiants CinetPay réels.
PAYMENT_PROVIDER=simulator
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_NOTIFY_URL=
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com
# Secret HMAC du provider `simulator` (auto-signature de ses propres
# webhooks de test) — sans rapport avec CinetPay, jamais utilisé en prod.
SIMULATOR_SECRET=dev-simulator-secret

# --- Frontend (web) ---
# Origine de api-fastapi telle que joignable depuis le NAVIGATEUR, pour
# `npm run dev` HORS Docker (api-fastapi seul sur son port par défaut 8000 —
# inlinée dans le bundle client au build de `next`).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Même chose, mais pour le build de l'image Docker `web` (docker-compose.yml,
# service `web`, args) : là, api-fastapi tourne à côté d'admin-django, donc
# publié sur le port décalé 8010, pas 8000 — d'où une variable distincte de
# NEXT_PUBLIC_API_URL ci-dessus (sans quoi docker-compose substituerait
# silencieusement celle-ci, fausse dans ce contexte). Inutile hors Docker.
# WEB_DOCKER_NEXT_PUBLIC_API_URL=http://localhost:8010
# Origine de api-fastapi telle que joignable depuis le conteneur `web`
# lui-même (composants serveur Next.js) — nom du service Docker, lue à
# l'exécution, jamais inlinée. Sans effet hors Docker (dev local direct).
# API_INTERNAL_URL=http://api-fastapi:8000
