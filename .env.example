# Copier ce fichier en `.env` puis renseigner les valeurs.
# `.env` est ignoré par git : aucun secret ne doit être commité.

# --- Postgres ---
POSTGRES_DB=billetterie
POSTGRES_USER=billetterie
POSTGRES_PASSWORD=

# --- Django (admin-django) ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://billetterie:${POSTGRES_PASSWORD}@postgres:5432/billetterie

# --- FastAPI (api-fastapi) ---
REDIS_URL=redis://redis:6379/0
JWT_SECRET=

# --- Paiement Mobile Money (CinetPay) ---
# PAYMENT_PROVIDER=simulator en développement tant qu'il n'y a pas
# d'identifiants CinetPay réels.
PAYMENT_PROVIDER=simulator
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_NOTIFY_URL=

# --- Frontend (web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
